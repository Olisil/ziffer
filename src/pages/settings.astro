---
// Settings: Account · Projects · Notifications · Plan & billing · Security — one panel with tabs.
import { UserProfile } from '@clerk/astro/components';
import App from '../layouts/App.astro';
import AppHeader from '../components/AppHeader.astro';
import { db, listEnvironments, listProjects, MAX_ENVIRONMENTS, ownerId, url, type Project } from '../lib/server';
import { BILLING_GRACE_DAYS, fmt, isDevUser } from '../lib/page';
import { billable, DEFAULT_NOTIFY, me, membersOf, PLAN_LABEL, prefsOf, type Access, type Member } from '../lib/users';
import { actorFor, answerRequest, can, deleteProject, invite, leave, remove, setAccess, transfer } from '../lib/members';
import { checkoutForProject, money, portalForProject, seatPrice, stripeEnabled, stripeTestMode } from '../lib/stripe';
import { mailEnabled } from '../lib/mail';
import { appOrigin } from '../lib/notify';

const owner = ownerId(Astro);
if (!owner) return Astro.redirect(url('sign-in'));
let user = (await me(Astro))!;
const TABS = [['account', 'Account'], ['projects', 'Projects'], ['notifications', 'Notifications'], ['plan', 'Plan & billing'], ['security', 'Security']] as const;
type Tab = (typeof TABS)[number][0];
const tab: Tab = (TABS.find(([k]) => k === Astro.url.searchParams.get('tab'))?.[0] ?? 'account') as Tab;
let flash = Astro.url.searchParams.get('ok') || '';
let error = '';
const back = (t: Tab, extra = '') => Astro.redirect(url(`settings?tab=${t}${extra}`));

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action') || '');
  const pid = String(f.get('project') || '');
  try {
    if (pid) {
      const a = await actorFor(user, pid);
      if (!a.role) throw new Error('You’re not a member of that project.');
      if (action === 'invite') { await invite(a, String(f.get('email') || ''), (f.get('access') === 'basic' ? 'basic' : 'pro') as Access, Astro.request); return back('projects', `&ok=${encodeURIComponent('Invitation sent')}#p-${pid}`); }
      if (action === 'access') { await setAccess(a, String(f.get('user')), (f.get('access') === 'basic' ? 'basic' : 'pro') as Access, Astro.request); return back('projects', `#p-${pid}`); }
      if (action === 'remove') { await remove(a, String(f.get('user')), Astro.request); return back('projects', `&ok=${encodeURIComponent('Removed')}#p-${pid}`); }
      if (action === 'leave') { await leave(a, Astro.request); return back('projects', `&ok=${encodeURIComponent('You left the project')}`); }
      if (action === 'transfer') { await transfer(a, String(f.get('user')), Astro.request); return back('projects', `&ok=${encodeURIComponent('Project handed over')}#p-${pid}`); }
      if (action === 'revoke') {
        if (!can.invite(a)) throw new Error('Only Pro members can manage invitations.');
        await db().prepare('UPDATE invitations SET revoked = 1 WHERE token = ? AND project_id = ?').bind(String(f.get('token')), pid).run();
        return back('projects', `#p-${pid}`);
      }
      if (action === 'request') { await answerRequest(a, String(f.get('request')), String(f.get('answer')) as any, Astro.request); return back('projects', `#p-${pid}`); }
      if (action === 'rename') {
        if (a.access !== 'pro') throw new Error('Basic members can’t rename projects.');
        const name = String(f.get('name') || '').trim().slice(0, 80);
        if (name) await db().prepare('UPDATE projects SET name = ? WHERE id = ?').bind(name, pid).run();
        return back('projects', `#p-${pid}`);
      }
      if (action === 'delete') {
        const p = await db().prepare('SELECT name FROM projects WHERE id = ?').bind(pid).first<{ name: string }>();
        if (String(f.get('confirm') || '').trim() !== p?.name) throw new Error(`Type the project name “${p?.name}” to delete it.`);
        await deleteProject(a);
        return back('projects', `&ok=${encodeURIComponent('Project deleted')}`);
      }
      if (action === 'checkout' || action === 'portal') {
        if (!can.billing(a)) throw new Error('Only the project owner handles billing.');
        const p = await db().prepare('SELECT * FROM projects WHERE id = ?').bind(pid).first<Project>();
        const to = action === 'portal' && p?.stripe_customer ? await portalForProject(p.stripe_customer, appOrigin(Astro.request)) : await checkoutForProject(p!, user, appOrigin(Astro.request));
        return Astro.redirect(to, 303);
      }
    }
    if (action === 'notify') {
      const prefs = { ...DEFAULT_NOTIFY } as any;
      for (const k of Object.keys(DEFAULT_NOTIFY)) if (typeof (DEFAULT_NOTIFY as any)[k] === 'boolean') prefs[k] = f.get(k) === 'on';
      prefs.weeklyDay = Math.min(6, Math.max(0, Number(f.get('weeklyDay')) || 1));
      await db().prepare('UPDATE users SET notify = ? WHERE id = ?').bind(JSON.stringify(prefs), user.id).run();
      return back('notifications', `&ok=${encodeURIComponent('Saved')}`);
    }
    if (action === 'read') { await db().prepare('UPDATE notifications SET read_at = ? WHERE user_id = ? AND read_at IS NULL').bind(Date.now(), user.id).run(); return back('notifications'); }
    if (action === 'plan') {
      const to = f.get('plan') === 'basic' ? 'basic' : 'pro';
      if (user.plan === 'owner' || user.plan === 'pro_free') throw new Error('Your plan is set by Nassau.');
      if (to === 'basic') {
        const owns = (await db().prepare("SELECT COUNT(*) AS n FROM project_members WHERE user_id = ? AND role = 'owner'").bind(user.id).first<{ n: number }>())?.n ?? 0;
        if (owns) throw new Error('Basic accounts can’t own projects. Hand your projects over to someone else (or delete them) first.');
      }
      await db().prepare('UPDATE users SET plan = ? WHERE id = ?').bind(to, user.id).run();
      return back('plan', `&ok=${encodeURIComponent(`You’re now on ${to === 'pro' ? 'Pro' : 'Basic – Free'}`)}`);
    }
  } catch (e: any) { error = e?.message || String(e); }
}

user = (await me(Astro))!;
const projects = await listProjects(owner);
const data = await Promise.all(projects.map(async (p) => {
  const [members, envs, invites, requests, seatsMonth] = await Promise.all([
    membersOf(p.id), listEnvironments(p.id),
    db().prepare('SELECT token, email, access, created, expires FROM invitations WHERE project_id = ? AND accepted_at IS NULL AND revoked = 0 AND expires > ? ORDER BY created DESC').bind(p.id, Date.now()).all<{ token: string; email: string; access: Access; created: number; expires: number }>().then((r) => r.results),
    db().prepare("SELECT id, email, domain, message, created FROM access_requests WHERE project_id = ? AND status = 'open' ORDER BY created").bind(p.id).all<{ id: string; email: string; domain: string; message: string | null; created: number }>().then((r) => r.results),
    db().prepare("SELECT COALESCE(SUM(seats), 0) AS d FROM billing_days WHERE project_id = ? AND substr(day, 1, 7) = ?").bind(p.id, new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Stockholm' }).slice(0, 7)).first<{ d: number }>().then((r) => r?.d ?? 0),
  ]);
  const a = await actorFor(user, p.id);
  return { p, members, envs, invites, requests, seatsMonth, a, billableSeats: members.filter(billable).length };
}));
const prefs = prefsOf(user);
const inbox = (await db().prepare('SELECT * FROM notifications WHERE user_id = ? ORDER BY created DESC LIMIT 40').bind(user.id).all<{ id: number; kind: string; title: string; body: string | null; link: string | null; created: number; read_at: number | null }>()).results;
const price = await seatPrice();
const priceText = price ? `${money(price.amount, price.currency)} per Pro seat / month` : 'Price set by Nassau';
const initials = (s: string | null) => (s || '?').split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((x) => x[0]!.toUpperCase()).join('');
const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const now = new Date();
const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
const monthName = now.toLocaleDateString('en-GB', { month: 'long', timeZone: 'Europe/Stockholm' });
const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const notifyRows: [keyof typeof DEFAULT_NOTIFY, string, string][] = [
  ['weekly', 'Weekly report', 'A short email with visitors, engagement, rage clicks and page changes for each of your sites.'],
  ['version', 'New site version', 'When Ziffer detects a new layout across a site (e.g. “Nassau web 2.0”).'],
  ['auditDrop', 'Audit score drops', 'When a page’s SEO / AEO / technical score falls by 10 points or more after a change.'],
  ['rage', 'Rage-click spikes', 'When visitors suddenly click in frustration much more than usual.'],
  ['traffic', 'Traffic spikes and drops', 'Unusually many or few visits — also catches a snippet that went missing.'],
  ['members', 'People', 'Invitations accepted, members leaving, requests to join your projects.'],
  ['billing', 'Billing', 'Changes in paid seats, invoices and failed payments (project owners).'],
  ['claims', 'Site confirmation', 'When a new site is confirmed by its first visit, or a reservation is about to lapse.'],
];
const PLANS = [
  { key: 'basic', name: 'Basic – Free', price: 'Free', points: ['View projects you’re invited to', 'Dashboards, sessions, heatmaps, versions and audits — read-only', 'Can’t create projects or export reports'] },
  { key: 'pro', name: 'Pro', price: price ? `${money(price.amount, price.currency)} / seat / month` : 'Paid per seat', points: ['Create projects with up to 4 environments', 'Edit everything, invite people, run audits, export reports', 'Each project pays for its Pro members after every full month'] },
  { key: 'pro_free', name: 'Pro – Free', price: 'Free', points: ['Everything in Pro, never billed', 'Given by Nassau'] },
  { key: 'owner', name: 'Owner', price: '—', points: ['The service owner (Nassau)', 'Everything, plus Admin'] },
];
const backTo = Astro.request.headers.get('referer')?.includes('/settings') ? url('') : Astro.request.headers.get('referer') || url('');
const devMode = isDevUser();
const inviteBase = `${new URL(Astro.request.url).origin}${url('invite/')}`;
---
<App title="Settings">
  <AppHeader projects={projects} devUser={devMode} />
  <main class="z-settings-wrap">
    <section class="z-settings" aria-label="Settings">
      <header class="z-settings-top">
        <nav class="z-settings-tabs" aria-label="Settings sections">
          {TABS.map(([k, label]) => <a href={url(`settings?tab=${k}`)} aria-current={tab === k ? 'page' : undefined}>{label}{k === 'notifications' && inbox.some((n) => !n.read_at) && <i class="z-dot"></i>}</a>)}
        </nav>
        <a class="z-settings-close" href={backTo} aria-label="Close settings">
          <svg width="16" height="16" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l10 10M13 3 3 13" /></svg>
        </a>
      </header>
      <div class="z-settings-body">
        {flash && <p class="z-flash">{flash}</p>}
        {error && <p class="z-flash bad" role="alert">{error}</p>}

        {tab === 'account' && (
          <div class="z-set-account">
            <div class="z-avatar-col">
              {user.image_url ? <img class="z-avatar-xl" src={user.image_url} alt="" /> : <span class="z-avatar-xl z-avatar-txt">{initials(user.name || user.email)}</span>}
              <a class="z-link" href={url('settings?tab=security')}>Edit</a>
            </div>
            <div class="z-set-rows">
              <div class="z-set-row"><h3>Name</h3><p>{user.name || '—'}</p><a href={url('settings?tab=security')}>Change name</a></div>
              <div class="z-set-row"><h3>Email</h3><p>{user.email || '—'} {user.email_verified ? <span class="z-signal engaged">Verified</span> : <span class="z-signal dead">Not verified</span>}</p><a href={url('settings?tab=security')}>Change email</a></div>
              <div class="z-set-row"><h3>Plan</h3><p>{PLAN_LABEL[user.plan]}</p><a href={url('settings?tab=plan')}>{user.plan === 'pro' || user.plan === 'basic' ? 'Change plan' : 'See plans'}</a></div>
              <hr />
              <div class="z-set-row"><h3>Your projects</h3>
                {projects.length === 0 && <p class="muted">None yet.</p>}
                <ul class="z-set-projects">
                  {data.map(({ p, a, envs }) => (
                    <li><span class="z-avatar-sq">{initials(p.name)}</span><span><b>{p.name}</b><span class="muted">{a.role === 'owner' ? 'Project owner' : 'Member'} · {a.access === 'pro' ? 'Pro' : 'Basic'} · {envs.length} of {MAX_ENVIRONMENTS} environments</span></span></li>
                  ))}
                </ul>
                <a href={url('settings?tab=projects')}>Manage projects and people</a>
              </div>
              <hr />
              <div class="z-set-row"><h3>Theme</h3>
                <div class="z-theme-pick" role="radiogroup" aria-label="Theme">
                  <button type="button" data-theme-set="light" class="z-theme-card light"><span></span>Light</button>
                  <button type="button" data-theme-set="dark" class="z-theme-card dark"><span></span>Dark</button>
                  <button type="button" data-theme-set="system" class="z-theme-card system"><span></span>Same as device</button>
                </div>
              </div>
              <div class="z-set-row"><h3>Language</h3><p>English</p><span class="muted" style="font-size:12.5px">Swedish is planned.</span></div>
            </div>
          </div>
        )}

        {tab === 'projects' && (
          <div class="z-set-projects-tab">
            <p class="muted z-set-intro">The project owner handles billing, can remove anyone, hand the project over and delete it. Pro members edit everything and can invite people; they can remove Basic members. Basic members read only. Anyone can leave a project.</p>
            {data.length === 0 && <p class="muted">You’re not in any projects yet.</p>}
            {data.map(({ p, members, envs, invites, requests, a, billableSeats }) => (
              <article class="z-set-project" id={`p-${p.id}`}>
                <header>
                  <span class="z-avatar-sq">{initials(p.name)}</span>
                  {a.access === 'pro' ? (
                    <form method="post" class="z-inline-rename"><input type="hidden" name="action" value="rename" /><input type="hidden" name="project" value={p.id} /><input class="z-input" name="name" value={p.name} maxlength="80" aria-label="Project name" /><button class="z-btn z-btn-secondary" type="submit">Rename</button></form>
                  ) : <h3>{p.name}</h3>}
                  <span class="muted">{envs.length} of {MAX_ENVIRONMENTS} environments · {members.length} {members.length === 1 ? 'person' : 'people'}{billableSeats ? ` · ${billableSeats} paid ${billableSeats === 1 ? 'seat' : 'seats'}` : ''}</span>
                </header>

                {requests.length > 0 && can.answerRequests(a) && (
                  <div class="z-requests">
                    {requests.map((r) => (
                      <form method="post" class="z-request">
                        <input type="hidden" name="action" value="request" /><input type="hidden" name="project" value={p.id} /><input type="hidden" name="request" value={r.id} />
                        <span><b>{r.email}</b> asks to join (tried to add {r.domain}){r.message && <> — “{r.message}”</>}</span>
                        <span class="z-request-actions">
                          <button class="z-btn z-btn-secondary" name="answer" value="pro">Invite as Pro</button>
                          <button class="z-btn z-btn-secondary" name="answer" value="basic">Invite as Basic</button>
                          <button class="z-link" name="answer" value="decline">Decline</button>
                        </span>
                      </form>
                    ))}
                  </div>
                )}

                <ul class="z-members">
                  {members.map((m: Member) => (
                    <li>
                      {m.image_url ? <img class="z-avatar" src={m.image_url} alt="" /> : <span class="z-avatar z-avatar-txt">{initials(m.name || m.email)}</span>}
                      <span class="z-member-who"><b>{m.name || m.email || 'Unknown'}{m.user_id === user.id && ' (you)'}</b><span class="muted">{m.email}</span></span>
                      <span class="z-member-tags">
                        {m.role === 'owner' && <span class="z-chip">Project owner</span>}
                        {can.changeAccess(a) && m.role !== 'owner' ? (
                          <form method="post" class="z-access-form">
                            <input type="hidden" name="action" value="access" /><input type="hidden" name="project" value={p.id} /><input type="hidden" name="user" value={m.user_id} />
                            <select class="z-select" name="access" onchange="this.form.submit()" aria-label={`Access for ${m.email}`}>
                              <option value="pro" selected={m.access === 'pro'}>Pro (edit)</option>
                              <option value="basic" selected={m.access === 'basic'}>Basic (view)</option>
                            </select>
                          </form>
                        ) : <span class={`z-chip ${m.access}`}>{m.access === 'pro' ? 'Pro' : 'Basic'}</span>}
                        {billable(m) ? <span class="muted z-seat" title="Billed to this project">paid seat</span> : m.access === 'pro' ? <span class="muted z-seat" title={`${PLAN_LABEL[m.plan]} plan`}>free seat</span> : null}
                      </span>
                      <span class="z-member-actions">
                        {can.transfer(a) && m.role !== 'owner' && m.plan !== 'basic' && (
                          <details class="z-confirm"><summary class="z-link">Make owner</summary>
                            <form method="post"><input type="hidden" name="action" value="transfer" /><input type="hidden" name="project" value={p.id} /><input type="hidden" name="user" value={m.user_id} />
                              <p class="muted">{m.name || m.email} becomes the project owner and handles members and billing. You stay as a Pro member.</p>
                              <button class="z-btn z-btn-secondary" type="submit">Hand over {p.name}</button></form>
                          </details>
                        )}
                        {can.remove(a, m) && (
                          <form method="post"><input type="hidden" name="action" value="remove" /><input type="hidden" name="project" value={p.id} /><input type="hidden" name="user" value={m.user_id} /><button class="z-link danger" type="submit">Remove</button></form>
                        )}
                      </span>
                    </li>
                  ))}
                  {invites.map((i) => (
                    <li class="pending">
                      <span class="z-avatar z-avatar-txt">✉</span>
                      <span class="z-member-who"><b>{i.email}</b><span class="muted">Invited {fmt.date(i.created)} · expires {fmt.date(i.expires)}</span></span>
                      <span class="z-member-tags"><span class={`z-chip ${i.access}`}>{i.access === 'pro' ? 'Pro' : 'Basic'}</span><span class="muted z-seat">pending</span></span>
                      <span class="z-member-actions">{can.invite(a) && <button class="z-link" type="button" data-copy={`${inviteBase}${i.token}`} onclick="navigator.clipboard.writeText(this.dataset.copy).then(()=>{this.textContent='Copied';setTimeout(()=>this.textContent='Copy link',2000)})">Copy link</button>}{can.invite(a) && <form method="post"><input type="hidden" name="action" value="revoke" /><input type="hidden" name="project" value={p.id} /><input type="hidden" name="token" value={i.token} /><button class="z-link" type="submit">Withdraw</button></form>}</span>
                    </li>
                  ))}
                </ul>

                {can.invite(a) && (
                  <form method="post" class="z-invite-form">
                    <input type="hidden" name="action" value="invite" /><input type="hidden" name="project" value={p.id} />
                    <input class="z-input" type="email" name="email" required placeholder="name@company.com" aria-label="Email to invite" />
                    <select class="z-select" name="access" aria-label="Access">
                      <option value="pro">Pro — can edit{price ? ` (${money(price.amount, price.currency)}/month)` : ''}</option>
                      <option value="basic">Basic – Free — view only</option>
                    </select>
                    <button class="z-btn z-btn-primary" type="submit">Invite</button>
                  </form>
                )}
                {!mailEnabled() && can.invite(a) && <p class="muted z-small">Email isn’t connected yet, so invitations are only shown here — share the invitation link from Admin until it is.</p>}

                <footer class="z-set-project-foot">
                  {can.leave(a) && <form method="post"><input type="hidden" name="action" value="leave" /><input type="hidden" name="project" value={p.id} /><button class="z-btn z-btn-secondary" type="submit">Leave project</button></form>}
                  {a.role === 'owner' && !can.leave(a) && <span class="muted z-small">To leave, hand the project over to another Pro member first.</span>}
                  <span class="z-spacer"></span>
                  {can.deleteProject(a) && (
                    <details class="z-confirm"><summary class="z-link danger">Delete project</summary>
                      <form method="post"><input type="hidden" name="action" value="delete" /><input type="hidden" name="project" value={p.id} />
                        <p class="muted">Deletes {p.name}, its {envs.length} {envs.length === 1 ? 'environment' : 'environments'} and all collected data. This can’t be undone.</p>
                        <input class="z-input" name="confirm" placeholder={`Type “${p.name}”`} autocomplete="off" />
                        <button class="z-btn z-btn-danger" type="submit">Delete forever</button></form>
                    </details>
                  )}
                </footer>
              </article>
            ))}
          </div>
        )}

        {tab === 'notifications' && (
          <div class="z-set-notify">
            <form method="post" class="z-notify-form">
              <input type="hidden" name="action" value="notify" />
              <h3>Tell me about</h3>
              {notifyRows.map(([k, title, hint]) => (
                <label class="z-switch-row">
                  <span><b>{title}</b><span class="muted">{hint}</span></span>
                  <input type="checkbox" class="z-switch" name={k} checked={!!(prefs as any)[k]} />
                </label>
              ))}
              <label class="z-switch-row"><span><b>Weekly report day</b><span class="muted">Sent in the morning, Stockholm time.</span></span>
                <select class="z-select" name="weeklyDay">{days.map((d, i) => <option value={i} selected={prefs.weeklyDay === i}>{d}</option>)}</select></label>
              <h3>How</h3>
              <label class="z-switch-row"><span><b>Also by email</b><span class="muted">{mailEnabled() ? `To ${user.email}. Notifications always appear under the bell in Ziffer.` : 'Email isn’t connected yet — notifications appear under the bell in Ziffer.'}</span></span>
                <input type="checkbox" class="z-switch" name="email" checked={prefs.email} /></label>
              <div><button class="z-btn z-btn-primary" type="submit">Save</button></div>
            </form>
            <div class="z-inbox">
              <div class="z-inbox-head"><h3>Inbox</h3>{inbox.some((n) => !n.read_at) && <form method="post"><input type="hidden" name="action" value="read" /><button class="z-link" type="submit">Mark all as read</button></form>}</div>
              {inbox.length === 0 && <p class="muted">Nothing yet.</p>}
              <ul>
                {inbox.map((n) => (
                  <li class:list={[{ unread: !n.read_at }]}>
                    <a href={n.link || '#'}><b>{n.title}</b><span class="muted">{(n.body || '').split('\n')[0]}</span><span class="muted z-small">{fmt.date(n.created)} {fmt.time(n.created)}</span></a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}

        {tab === 'plan' && (
          <div class="z-set-plan">
            <h3>Your plan</h3>
            <div class="z-plans">
              {PLANS.filter((x) => x.key !== 'owner' || user.plan === 'owner').filter((x) => x.key !== 'pro_free' || user.plan === 'pro_free').map((x) => (
                <div class:list={['z-plan', { current: user.plan === x.key }]}>
                  <div class="z-plan-head"><b>{x.name}</b>{user.plan === x.key && <span class="z-chip z-chip-live">Current</span>}</div>
                  <div class="z-plan-price">{x.price}</div>
                  <ul>{x.points.map((pt) => <li>{pt}</li>)}</ul>
                  {(user.plan === 'pro' || user.plan === 'basic') && user.plan !== x.key && (x.key === 'pro' || x.key === 'basic') && (
                    <form method="post"><input type="hidden" name="action" value="plan" /><input type="hidden" name="plan" value={x.key} />
                      <button class:list={['z-btn', x.key === 'pro' ? 'z-btn-primary' : 'z-btn-secondary']} type="submit">{x.key === 'pro' ? 'Upgrade to Pro' : 'Switch to Basic – Free'}</button></form>
                  )}
                </div>
              ))}
            </div>
            <h3>Project billing</h3>
            <p class="muted z-set-intro">Each project pays for its Pro members. Seats are counted every day; after each full month the project is charged for the days each paid seat was active ({priceText}). Basic members and people on Pro – Free are never charged.{stripeTestMode() && ' Stripe is in test mode — no real charges.'}</p>
            {data.filter(({ a }) => a.role === 'owner' || user.plan === 'owner').length === 0 && <p class="muted">You don’t own any projects, so there’s nothing to pay. Project owners handle billing.</p>}
            <div class="z-bills">
              {data.filter(({ a }) => a.role === 'owner').map(({ p, members, billableSeats, seatsMonth }) => {
                const est = price ? Math.round((seatsMonth / daysInMonth) * price.amount) : null;
                const grace = new Date(p.created + BILLING_GRACE_DAYS * 864e5);
                return (
                  <article class="z-bill">
                    <header><b>{p.name}</b>{p.billing_status === 'active' ? <span class="z-signal engaged">Card on file</span> : p.billing_status === 'past_due' ? <span class="z-signal rage">Payment failed</span> : billableSeats ? <span class="z-signal dead">No card yet</span> : <span class="z-signal bounce">Nothing to pay</span>}</header>
                    <dl>
                      <div><dt>Paid seats now</dt><dd>{billableSeats}</dd></div>
                      <div><dt>{monthName} so far</dt><dd>{(seatsMonth / daysInMonth).toFixed(2)} seat-months</dd></div>
                      <div><dt>Estimate for {monthName}</dt><dd>{est !== null ? money(est, price!.currency) : '—'}</dd></div>
                      <div><dt>Charged</dt><dd>after {monthEnd}</dd></div>
                    </dl>
                    <p class="muted z-small">{members.filter(billable).map((m) => m.name || m.email).join(', ') || 'No paid seats — everyone here is Basic or on a free plan.'}</p>
                    {!stripeEnabled() ? <p class="muted z-small">Payments aren’t connected yet.</p> : (
                      <form method="post" class="z-bill-actions">
                        <input type="hidden" name="project" value={p.id} />
                        {p.stripe_customer && p.billing_status ? <button class="z-btn z-btn-secondary" name="action" value="portal">Manage card and invoices</button>
                          : billableSeats > 0 && <button class="z-btn z-btn-primary" name="action" value="checkout">Add a payment card</button>}
                        {!p.billing_status && billableSeats > 0 && <span class="muted z-small">Needed by {grace.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })} to keep editing.</span>}
                      </form>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        )}

        {tab === 'security' && (
          <div class="z-set-security">
            {devMode ? <p class="muted">Local development: account security is handled by Clerk in the deployed app.</p>
              : <UserProfile routing="hash" />}
          </div>
        )}
      </div>
    </section>
  </main>
</App>
<script>
  // Theme cards: light, dark or follow the device (stored like the header toggle).
  const KEY = 'ziffer-theme';
  const mark = () => {
    let v = 'system'; try { v = localStorage.getItem(KEY) || 'system'; } catch {}
    document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === v)));
  };
  document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((b) => b.addEventListener('click', () => {
    const v = b.dataset.themeSet!;
    if (v === 'system') {
      try { localStorage.removeItem(KEY); } catch {}
      const dark = matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('theme-dark', dark);
    } else (window as any).zifferTheme?.set(v);
    mark();
  }));
  mark();
</script>
