---
import SiteIcon from '../../../components/SiteIcon.astro';
import SettingsNav from '../../../components/SettingsNav.astro';
import App from '../../../layouts/App.astro';
import AppHeader from '../../../components/AppHeader.astro';
import InstallSnippet from '../../../components/InstallSnippet.astro';
import { loadEnvPage } from '../../../lib/page';
import { cleanDomain, db, url } from '../../../lib/server';
import { bucket } from '../../../lib/snapshots';
import { CLAIM_DAYS, conflictMessage, domainConflict, type Conflict } from '../../../lib/claims';
import { fmt } from '../../../lib/page';

const ctx = await loadEnvPage(Astro);
if (ctx instanceof Response) return ctx;
const { env, project, projects, environments, devUser, canEdit, readOnlyReason } = ctx;
const reservedUntil = env.verified_at ? null : env.created + CLAIM_DAYS * 864e5;
let notice = Astro.url.searchParams.get('welcome') ? 'welcome' : '';
let error = '';
let conflict: Conflict | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action'));
  if (action === 'update') {
    const name = String(form.get('name') || '').trim().slice(0, 80);
    const domainRaw = String(form.get('domain') || '').trim();
    const domain = domainRaw ? cleanDomain(domainRaw) : null;
    if (!name) error = 'The name can’t be empty.';
    else if (env.kind === 'web' && !domain) error = 'Enter a valid domain, for example nassau.se.';
    else if (domain && domain !== env.domain && (conflict = await domainConflict(domain, ctx.owner, env.id))) error = conflictMessage(domain, conflict);
    else {
      // A new domain has to be confirmed again by a visit through the snippet.
      await db().prepare('UPDATE environments SET name = ?, domain = ?, verified_at = CASE WHEN domain IS ? THEN verified_at ELSE NULL END, created = CASE WHEN domain IS ? THEN created ELSE ? END WHERE id = ?')
        .bind(name, domain, domain, domain, Date.now(), env.id).run();
      return Astro.redirect(url(`e/${env.id}/settings?saved=1`));
    }
  } else if (action === 'delete') {
    if (String(form.get('confirm') || '').trim() !== env.name) error = `Type “${env.name}” to confirm.`;
    else {
      const snaps = await db().prepare('SELECT r2_key FROM snapshots WHERE env_id = ?').bind(env.id).all<{ r2_key: string }>();
      if (snaps.results.length) await bucket()?.delete(snaps.results.map((r) => r.r2_key));
      await db().batch([
        db().prepare('DELETE FROM snapshots WHERE env_id = ?').bind(env.id),
        db().prepare('DELETE FROM clicks WHERE env_id = ?').bind(env.id),
        db().prepare('DELETE FROM pageviews WHERE env_id = ?').bind(env.id),
        db().prepare('DELETE FROM sessions WHERE env_id = ?').bind(env.id),
        db().prepare('DELETE FROM environments WHERE id = ?').bind(env.id),
      ]);
      return Astro.redirect(url(`p/${project.id}`));
    }
  }
}
if (Astro.url.searchParams.get('saved')) notice = 'saved';
---
<App title={`${env.name} · Settings`}>
  <AppHeader projects={projects} project={project} environments={environments} env={env} tab="settings" devUser={devUser} readOnly={ctx.readOnlyReason} />
  <main class="z-main" style="max-width:880px">
    <div class="z-title-row">
      <div class="z-title-id">
        <SiteIcon env={env} name={env.name} size={44} />
        <div>
          <div class="z-eyebrow">{project.name} · {env.name}</div>
          <h1 class="z-h1">Settings</h1>
        </div>
      </div>
    </div>
    <SettingsNav project={project} env={env} current="site" />
    {notice === 'welcome' && env.kind === 'web' && (
      <p class="z-card" style="margin:0"><b>{env.name} is ready.</b> <span class="muted">Add the snippet below to the site and publish — the dashboard fills in as visitors arrive.</span></p>
    )}
    {notice === 'saved' && <p class="z-card" style="margin:0">Saved.</p>}
    {error && <p class="z-card" role="alert" style="margin:0;color:var(--z-coral)">{error}</p>}

    {env.kind === 'web' && (
      <section class="z-card">
        <div class="z-card-head"><span class="z-card-title">Install</span><span class="z-card-hint">Site key {env.site_key}</span></div>
        {env.domain && (env.verified_at
          ? <p class="z-claim ok"><span class="z-st pass"></span>{env.domain} is confirmed for this project since {fmt.date(env.verified_at)}.</p>
          : <p class="z-claim"><span class="z-st warn"></span>{env.domain} is reserved for this project until {fmt.date(reservedUntil!)}. It’s confirmed as soon as the first visit arrives through this snippet — otherwise the reservation lapses.</p>)}
        <InstallSnippet siteKey={env.site_key} domain={env.domain} envId={env.id} />
      </section>
    )}

    {!canEdit && <p class="z-card z-readonly" style="margin:0">{readOnlyReason}</p>}
    {canEdit && <section class="z-card">
      <div class="z-card-head"><span class="z-card-title">Environment</span><span class="z-card-hint">{env.kind === 'web' ? 'Web' : 'Virtual tour'}</span></div>
      <form method="post" class="z-form">
        <input type="hidden" name="action" value="update" />
        <label class="z-field">Name<input class="z-input" name="name" required maxlength="80" value={env.name} /></label>
        <label class="z-field">Domain <small>{env.kind === 'web' ? 'Only this domain (with www and subdomains) can send data.' : 'Optional for tours.'}</small>
          <input class="z-input" name="domain" maxlength="200" value={env.domain || ''} />
        </label>
        <div><button class="z-btn z-btn-primary" type="submit">Save</button></div>
      </form>
    </section>}

    <section class="z-card">
      <div class="z-card-head"><span class="z-card-title">Privacy</span></div>
      <ul class="muted" style="margin:0;padding-left:18px;font-size:13px;line-height:1.7">
        <li>No cookies or local identifiers that survive the tab. Visitors are counted with a hash that changes every day.</li>
        <li>No form input, typed text or query strings are recorded — only paths, click positions and short element selectors.</li>
        <li>For heatmaps, a visitor’s browser occasionally sends a copy of the page layout (at most every few days per page). Scripts and form values are removed first; add <code>data-ziffer-mask</code> to any element that should be blanked out.</li>
        <li>Data stays in this Webflow Cloud app’s storage; moving analytics to EU-only storage is planned.</li>
      </ul>
    </section>

    {canEdit && <section class="z-card">
      <div class="z-card-head"><span class="z-card-title">Delete environment</span></div>
      <form method="post" class="z-form">
        <input type="hidden" name="action" value="delete" />
        <p class="muted" style="margin:0;font-size:13px">Removes {env.name} and all of its sessions, page views, clicks and page snapshots. This can’t be undone.</p>
        <label class="z-field"><span>Type <b>{env.name}</b> to confirm</span><input class="z-input" name="confirm" autocomplete="off" /></label>
        <div><button class="z-btn z-btn-danger" type="submit">Delete environment</button></div>
      </form>
    </section>}
  </main>
</App>
