---
import { UserButton } from '@clerk/astro/components';
import Logo from './Logo.astro';
import { db, rangeOf, rangeQuery, url, type Environment, type Project } from '../lib/server';
import { isServiceOwner, me } from '../lib/users';

interface Props {
  projects: Project[];
  project?: Project;
  environments?: Environment[];
  env?: Environment;
  tab?: 'dashboard' | 'heatmaps' | 'sessions' | 'versions' | 'audits' | 'settings';
  devUser?: boolean;
  readOnly?: string | null;
}
const { projects, project, environments = [], env, tab, devUser = false, readOnly = null } = Astro.props;
const base = env ? url(`e/${env.id}`) : '';
const sp = Astro.url.searchParams;
const q = sp.get('range') || sp.get('from') ? `?${rangeQuery(rangeOf(Astro.url))}` : '';
const tabs = env
  ? (env.kind === 'web'
      ? [['dashboard', 'Dashboard', ''], ['sessions', 'Sessions', '/sessions'], ['heatmaps', 'Heatmaps', '/heatmaps'], ['versions', 'Versions', '/versions'], ['audits', 'Audits', '/audits'], ['settings', 'Settings', '/settings']]
      : [['dashboard', 'Dashboard', ''], ['settings', 'Settings', '/settings']])
  : [];
const viewer = await me(Astro).catch(() => null);
const unread = viewer ? ((await db().prepare('SELECT COUNT(*) AS n FROM notifications WHERE user_id = ? AND read_at IS NULL').bind(viewer.id).first<{ n: number }>())?.n ?? 0) : 0;
const admin = isServiceOwner(viewer);
const kindLabel = (k: string) => (k === 'web' ? 'Web' : 'Virtual tour');
const initial = (s?: string) => (s || '?').trim().charAt(0).toUpperCase();
---
<header class="z-app-header">
  <a class="z-logo" href={url('')} aria-label="Probe home">
    <Logo id="app-header" height={30} class="z-logo-full" />
    <Logo id="app-header-mark" height={28} symbolOnly class="z-logo-mark" />
  </a>
  {project && (
    <>
      <div class="z-divider" aria-hidden="true"></div>
      <details class="z-scope project">
        <summary><span class="z-avatar-sq">{initial(project.name)}</span>{project.name}</summary>
        <div class="z-scope-menu" role="menu">
          <a href={url('')}><span class="z-avatar-sq">◎</span>All sites overview</a>
          <div class="z-menu-sep"></div>
          <div class="z-menu-label">Projects</div>
          {projects.map((p) => (
            <a href={url(`p/${p.id}`)} aria-current={p.id === project.id ? 'true' : undefined}><span class="z-avatar-sq">{initial(p.name)}</span>{p.name}</a>
          ))}
          <div class="z-menu-sep"></div>
          <a href={url('new')}>+ New project</a>
        </div>
      </details>
    </>
  )}
  {env && (
    <details class="z-scope env">
      <summary><span class={`z-dot ${env.kind}`}></span>{env.name} · {kindLabel(env.kind)}</summary>
      <div class="z-scope-menu" role="menu">
        <div class="z-menu-label">Environments in {project?.name}</div>
        {environments.map((e) => (
          <a href={url(`e/${e.id}${q}`)} aria-current={e.id === env.id ? 'true' : undefined}><span class={`z-dot ${e.kind}`}></span>{e.name} · {kindLabel(e.kind)}</a>
        ))}
        <div class="z-menu-sep"></div>
        <a href={url(`p/${env.project_id}/environments/new`)}>+ Add environment</a>
      </div>
    </details>
  )}
  {!env && (
    <nav class="z-tabs" aria-label="Views"><a class="z-tab" href={url('')} aria-current="page">Overview</a></nav>
  )}
  {tabs.length > 0 && (
    <nav class="z-tabs" aria-label="Views">
      {tabs.map(([key, label, path]) => (
        <a class="z-tab" href={`${base}${path}${key === 'settings' || key === 'versions' || key === 'audits' ? '' : q}`} aria-current={tab === key ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  )}
  <div class="z-spacer"></div>
  {readOnly && <span class="z-chip z-ro" title={readOnly}>Read-only</span>}
  {admin && <a class="z-chip z-admin-link" href={url('admin')}>Admin</a>}
  <a class="z-toggle z-bell" href={url('settings?tab=notifications')} aria-label={unread ? `${unread} unread notifications` : 'Notifications'}>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 11.5V7a4 4 0 0 1 8 0v4.5l1.2 1.3H2.8z" stroke-linejoin="round" /><path d="M6.5 14.2a1.6 1.6 0 0 0 3 0" /></svg>
    {unread > 0 && <span class="z-bell-dot">{unread > 9 ? '9+' : unread}</span>}
  </a>
  <a class="z-toggle" href={url('settings')} aria-label="Settings">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="2.2" /><path d="M8 1.5v1.8M8 12.7v1.8M14.5 8h-1.8M3.3 8H1.5M12.6 3.4l-1.3 1.3M4.7 11.3l-1.3 1.3M12.6 12.6l-1.3-1.3M4.7 4.7 3.4 3.4" stroke-linecap="round" /></svg>
  </a>
  <button class="z-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" /></svg>
  </button>
  {devUser ? <span class="z-chip" title="Local development user">dev</span> : <UserButton afterSignOutUrl={url('sign-in')} />}
</header>
{tabs.length > 0 && (
  <nav class="z-mobile-tabs" aria-label="Views">
    {tabs.map(([key, label, path]) => (
      <a class="z-tab" href={`${base}${path}${key === 'settings' || key === 'versions' || key === 'audits' ? '' : q}`} aria-current={tab === key ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
)}
