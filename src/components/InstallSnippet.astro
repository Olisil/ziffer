---
import { url } from '../lib/server';
interface Props { siteKey: string; domain: string | null }
const { siteKey, domain } = Astro.props;
const src = new URL(url('z.js'), Astro.url.origin).href;
const snippet = `<script defer src="${src}" data-site="${siteKey}"></script>`;
---
<div class="z-form" style="max-width:none;gap:10px">
  <p class="muted" style="margin:0">
    Paste this before <code>&lt;/head&gt;</code> on every page of <b>{domain}</b>. In Webflow: <i>Site settings → Custom code → Head code</i>, then publish.
  </p>
  <textarea class="z-code" rows="2" readonly onclick="this.select()" aria-label="Install snippet">{snippet}</textarea>
  <div style="display:flex;gap:8px;align-items:center">
    <button class="z-btn z-btn-secondary" type="button" data-copy={snippet}>Copy snippet</button>
    <span class="muted" style="font-size:12px">No cookies · no text or form input recorded · Ziffer’s own previews are ignored</span>
  </div>
</div>
<script is:inline>
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-copy]');
    if (!b) return;
    navigator.clipboard.writeText(b.getAttribute('data-copy')).then(function () { var t = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = t; }, 1500); });
  });
</script>
