---
import App from '../../../../layouts/App.astro';
import AppHeader from '../../../../components/AppHeader.astro';
import JourneyRibbon from '../../../../components/JourneyRibbon.astro';
import SnapshotView from '../../../../components/SnapshotView.astro';
import DeviceIcon from '../../../../components/DeviceIcon.astro';
import { loadEnvPage, fmt } from '../../../../lib/page';
import { url } from '../../../../lib/server';
import { sessionStory } from '../../../../lib/stats';
import { getSnapshot } from '../../../../lib/snapshots';
import { anchorsOf } from '../../../../lib/anchors';
import { listVersions } from '../../../../lib/versions';
import { countryName, flag, signalsOf } from '../../../../lib/look';

const ctx = await loadEnvPage(Astro);
if (ctx instanceof Response) return ctx;
const { env, project, projects, environments, devUser } = ctx;
const story = await sessionStory(env.id, String(Astro.params.sid));
if (!story) return new Response('Not found', { status: 404 });
const { s, views, newer, older } = story;
const q = Astro.url.search;
const back = url(`e/${env.id}/sessions${q}`);

const bucket = (vw: number) => (vw && vw < 768 ? 'mobile' : 'desktop');
const versions = await listVersions(env.id, env.name);
const ver = versions.find((x) => s.started >= x.from && s.started < x.to) ?? null;
const snaps = new Map<string, Awaited<ReturnType<typeof getSnapshot>>>();
for (const v of views) {
  const k = `${bucket(v.vw)}|${v.path}`;
  if (!snaps.has(k)) snaps.set(k, await getSnapshot(env.id, v.path, bucket(v.vw), { from: ver?.from, to: ver && Number.isFinite(ver.to) ? ver.to : undefined }).catch(() => null));
}
const allClicks = views.flatMap((v) => v.clicks);
const maxScroll = Math.max(0, ...views.map((v) => v.scroll || 0));
const signals = signalsOf(s, maxScroll);
const offset = (ts: number) => {
  const sec = Math.max(0, Math.round((ts - s.started) / 1000));
  return `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;
};
let n = 0;
const chapters = views.map((v, i) => {
  const snap = snaps.get(`${bucket(v.vw)}|${v.path}`) ?? null;
  const W = snap?.dw || v.dw || (bucket(v.vw) === 'mobile' ? 390 : 1280);
  const H = Math.min(snap?.dh || v.dh || 3000, 30000);
  const viewW = snap?.vw || v.vw || W;
  const viewH = Math.min(snap?.vh || v.vh || 800, 760);
  const clicks = v.clicks.map((c) => ({ ...c, n: ++n }));
  const pts = clicks.map((c) => [Math.round(c.xr * W), Math.round(c.dh ? (c.y * H) / c.dh : c.y), c.rage, c.dead, c.n] as [number, number, number, number, number]);
  // What was on screen: the deepest scroll, and never above a spot that was clicked.
  const seen = Math.max(Math.round(((v.scroll || 0) / 100) * H), ...pts.map((p) => p[1] + 60));
  return {
    v, i, snap, W, H, viewW, viewH, clicks,
    overlay: {
      mode: 'path' as const,
      fold: snap?.vh || v.vh || 0,
      seen,
      clicks: pts,
      ...anchorsOf(clicks),
    },
    snapshotUrl: snap ? url(`e/${env.id}/snapshot?page=${encodeURIComponent(v.path)}&device=${bucket(v.vw)}&sv=${encodeURIComponent(snap.version_id)}&v=${snap.ts}`) : null,
  };
});
const tech = [s.browser, s.os].filter(Boolean).join(' on ');
---
<App title="Session">
  <AppHeader projects={projects} project={project} environments={environments} env={env} tab="sessions" devUser={devUser} readOnly={ctx.readOnlyReason} />
  <main class="z-main">
    <nav class="z-story-nav">
      <a href={back} class="z-back">← All sessions</a>
      <span class="z-spacer"></span>
      {newer ? <a class="z-btn z-btn-secondary" href={url(`e/${env.id}/sessions/${newer}${q}`)}>← Newer</a> : <span class="z-btn z-btn-secondary" aria-disabled="true">← Newer</span>}
      {older ? <a class="z-btn z-btn-secondary" href={url(`e/${env.id}/sessions/${older}${q}`)}>Older →</a> : <span class="z-btn z-btn-secondary" aria-disabled="true">Older →</span>}
    </nav>

    <section class="z-card z-story-head">
      <div class="z-story-title">
        <div class="z-eyebrow">{fmt.date(s.started)} · {fmt.time(s.started)}</div>
        <h1 class="z-h1">{s.entry_path}{s.exit_path && s.exit_path !== s.entry_path ? <><span class="muted"> → </span>{s.exit_path}</> : ''}</h1>
        <div class="z-story-meta">
          <span><DeviceIcon device={s.device} /> {fmt.device(s.device)}{tech ? ` · ${tech}` : ''}</span>
          <span title={countryName(s.country)}>{flag(s.country)} {countryName(s.country) || 'Unknown country'}</span>
          <span>From {s.referrer || 'a direct visit'}</span>
          {s.ai && <span class="z-ai-tag">via {s.ai}</span>}
        </div>
        {signals.length > 0 && <div class="z-sc-signals">{signals.map((g) => <span class={`z-signal ${g.key}`}>{g.label}</span>)}</div>}
      </div>
      <div class="z-story-stats">
        <div><b>{fmt.dur(s.duration)}</b><small>engaged time</small></div>
        <div><b>{s.pageviews}</b><small>{s.pageviews === 1 ? 'page' : 'pages'}</small></div>
        <div><b>{allClicks.length}</b><small>clicks</small></div>
        <div><b>{fmt.pct(maxScroll)}</b><small>deepest scroll</small></div>
      </div>
      <div class="z-story-ribbon">
        <JourneyRibbon pages={views} clicks={allClicks} large />
        <div class="z-story-axis"><span>0:00</span><span>{fmt.dur(s.duration)} engaged</span></div>
      </div>
    </section>

    {chapters.map((c) => (
      <section class="z-card z-chapter" id={`page-${c.i + 1}`}>
        <aside class="z-chapter-info">
          <div class="z-chapter-head">
            <span class="z-chapter-n">{c.i + 1}</span>
            <div>
              <div class="z-chapter-path">{c.v.path}</div>
              <div class="muted z-chapter-title">{c.v.title || 'Untitled page'}</div>
            </div>
          </div>
          <dl class="z-facts">
            <div><dt>Arrived</dt><dd>{offset(c.v.ts)}</dd></div>
            <div><dt>Time on page</dt><dd>{fmt.dur(c.v.duration)}</dd></div>
            <div><dt>Scrolled</dt><dd><span class="z-meter"><i style={`width:${Math.round(c.v.scroll || 0)}%`}></i></span>{fmt.pct(c.v.scroll)}</dd></div>
            <div><dt>Screen</dt><dd>{c.v.vw}×{c.v.vh}</dd></div>
          </dl>
          <div class="z-clicklist">
            <div class="z-menu-label">Clicks</div>
            {c.clicks.length === 0 && <p class="muted" style="margin:0;font-size:13px">No clicks on this page — the visitor read, scrolled or left.</p>}
            <ol>
              {c.clicks.map((k) => (
                <li class:list={[{ rage: k.rage, dead: k.dead }]}>
                  <span class="z-clicknum">{k.n}</span>
                  <span class="z-clicksel"><code>{(k.sel || 'page').split('>').pop()}</code>{k.rage ? <span class="z-signal rage">Rage</span> : k.dead ? <span class="z-signal dead">Dead</span> : null}</span>
                  <span class="muted">{offset(k.ts)}</span>
                </li>
              ))}
            </ol>
          </div>
          <a class="z-btn z-btn-secondary" href={url(`e/${env.id}/heatmaps?page=${encodeURIComponent(c.v.path)}&device=${bucket(c.v.vw)}`)}>All visitors on this page →</a>
        </aside>
        <div class="z-chapter-view">
          <SnapshotView snapshot={c.snapshotUrl} W={c.W} H={c.H} viewW={c.viewW} viewH={c.viewH} overlay={c.overlay} title={`${c.v.path}: this visit's clicks`} />
          <p class="muted z-chapter-note">{c.snap ? `Clicks numbered in order on the page as it looked ${fmt.date(c.snap.ts)}. The darkened part was never on screen.` : 'No picture of this page yet, so clicks are shown on a plain page. One is taken on a later visit.'}</p>
        </div>
      </section>
    ))}
  </main>
</App>
