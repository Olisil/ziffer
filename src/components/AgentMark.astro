---
// The mark for agent access: a four-point spark, used wherever AI agents reading Probe are mentioned.
interface Props { size?: number }
const { size = 14 } = Astro.props;
---
<svg class="z-agent-mark" width={size} height={size} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0.8c.5 3.9 2.3 5.7 6.4 6.4v1.6C10.300 9.5 8.500 11.300 8 15.200H8c-.5-3.900-2.300-5.700-6.400-6.400V7.200C5.700 6.500 7.500 4.700 8 .8z" /></svg>
