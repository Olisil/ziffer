---
import { UserButton } from '@clerk/astro/components';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SiteIcon from './SiteIcon.astro';
import { db, rangeOf, rangeQuery, url, type Environment, type Project } from '../lib/server';
import { isServiceOwner, me } from '../lib/users';

interface Props {
  projects: Project[];
  project?: Project;
  environments?: Environment[];
  env?: Environment;
  tab?: 'dashboard' | 'heatmaps' | 'sessions' | 'versions' | 'audits' | 'settings';
  devUser?: boolean;
  readOnly?: string | null;
}
const { projects, project, environments = [], env, tab, devUser = false, readOnly = null } = Astro.props;
const base = env ? url(`e/${env.id}`) : '';
const sp = Astro.url.searchParams;
const q = sp.get('range') || sp.get('from') ? `?${rangeQuery(rangeOf(Astro.url))}` : '';
const tabs = env
  ? (env.kind === 'web'
      ? [['dashboard', 'Dashboard', ''], ['sessions', 'Sessions', '/sessions'], ['heatmaps', 'Heatmaps', '/heatmaps'], ['audits', 'Audits', '/audits'], ['settings', 'Settings', '/settings']]
      : [['dashboard', 'Dashboard', ''], ['settings', 'Settings', '/settings']])
  : [];
// On phones the Versions button sits with the other views.
const mobileTabs = env?.kind === 'web' ? [...tabs.slice(0, 3), ['versions', 'Versions', '/versions'], ...tabs.slice(3)] : tabs;
const noRange = (k: string) => k === 'settings' || k === 'versions' || k === 'audits';
const viewer = await me(Astro).catch(() => null);
const unread = viewer ? ((await db().prepare('SELECT COUNT(*) AS n FROM notifications WHERE user_id = ? AND read_at IS NULL').bind(viewer.id).first<{ n: number }>())?.n ?? 0) : 0;
const admin = isServiceOwner(viewer);
const kindLabel = (k: string) => (k === 'web' ? 'Web' : 'Virtual tour');
const initial = (s?: string) => (s || '?').trim().charAt(0).toUpperCase();
// Each project is pictured by its first website's favicon.
const siteOf = new Map<string, { id: string; kind: string; domain: string | null }>();
if (projects.length) {
  const rows = await db().prepare(`SELECT id, project_id, kind, domain FROM environments WHERE kind = 'web' AND domain IS NOT NULL AND project_id IN (${projects.map(() => '?').join(',')}) ORDER BY created`).bind(...projects.map((p) => p.id)).all<{ id: string; project_id: string; kind: string; domain: string }>();
  for (const r of rows.results ?? []) if (!siteOf.has(r.project_id)) siteOf.set(r.project_id, r);
}
---
<header class="z-app-header">
  <a class="z-logo" href={url('')} aria-label="Probe home">
    <Logo id="app-header" height={34} class="z-logo-full" />
    <Logo id="app-header-mark" height={28} symbolOnly class="z-logo-mark" />
  </a>
  {project && (
    <>
      <div class="z-divider" aria-hidden="true"></div>
      <details class="z-scope project">
        <summary><SiteIcon env={siteOf.get(project.id)} name={project.name} size={22} />{project.name}</summary>
        <div class="z-scope-menu" role="menu">
          <a href={url('')}><span class="z-avatar-sq" style="width:22px;height:22px;border-radius:7px">◎</span>All sites overview</a>
          <div class="z-menu-sep"></div>
          <div class="z-menu-label">Projects</div>
          {projects.map((p) => (
            <a href={url(`p/${p.id}`)} aria-current={p.id === project.id ? 'true' : undefined}><SiteIcon env={siteOf.get(p.id)} name={p.name} size={22} />{p.name}</a>
          ))}
          <div class="z-menu-sep"></div>
          <a href={url(`p/${project.id}/settings${env ? `?from=${env.id}` : ''}`)}><span class="z-menu-ico"><Icon name="settings" size={16} /></span>Project settings and people</a>
          <a href={url('new')}>+ New project</a>
        </div>
      </details>
    </>
  )}
  {env && (
    <details class="z-scope env">
      <summary>{env.kind === 'web' ? <SiteIcon env={env} name={env.name} size={20} /> : <span class={`z-dot ${env.kind}`}></span>}{env.name} · {kindLabel(env.kind)}</summary>
      <div class="z-scope-menu" role="menu">
        <div class="z-menu-label">Environments in {project?.name}</div>
        {environments.map((e) => (
          <a href={url(`e/${e.id}${q}`)} aria-current={e.id === env.id ? 'true' : undefined}>{e.kind === 'web' ? <SiteIcon env={e} name={e.name} size={20} /> : <span class={`z-dot ${e.kind}`}></span>}{e.name} · {kindLabel(e.kind)}</a>
        ))}
        <div class="z-menu-sep"></div>
        <a href={url(`p/${env.project_id}/environments/new`)}>+ Add environment</a>
      </div>
    </details>
  )}
  {env?.kind === 'web' && (
    <a class="z-ver-btn" href={`${base}/versions`} aria-current={tab === 'versions' ? 'page' : undefined} title="Versions" aria-label="Versions">
      <Icon name="versions" size={18} />
    </a>
  )}
  {!env && (
    <nav class="z-tabs" aria-label="Views"><a class="z-tab" href={url('')} aria-current="page"><Icon name="overview" /><span class="z-tab-label">Overview</span></a></nav>
  )}
  {tabs.length > 0 && (
    <nav class="z-tabs" aria-label="Views">
      {tabs.map(([key, label, path]) => (
        <a class="z-tab" href={`${base}${path}${noRange(key) ? '' : q}`} aria-current={tab === key ? 'page' : undefined} title={label}><Icon name={key as any} /><span class="z-tab-label">{label}</span></a>
      ))}
    </nav>
  )}
  <div class="z-spacer"></div>
  {readOnly && <span class="z-chip z-ro" title={readOnly}>Read-only</span>}
  {admin && <a class="z-chip z-admin-link" href={url('admin')}>Admin</a>}
  <a class="z-toggle z-bell" href={url('settings?tab=notifications')} aria-label={unread ? `${unread} unread notifications` : 'Notifications'}>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 11.5V7a4 4 0 0 1 8 0v4.5l1.2 1.3H2.8z" stroke-linejoin="round" /><path d="M6.5 14.2a1.6 1.6 0 0 0 3 0" /></svg>
    {unread > 0 && <span class="z-bell-dot">{unread > 9 ? '9+' : unread}</span>}
  </a>
  <a class="z-toggle" href={url('settings')} aria-label="Settings">
    <Icon name="settings" size={17} />
  </a>
  <button class="z-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" /></svg>
  </button>
  {devUser ? <span class="z-chip" title="Local development user">dev</span> : <UserButton afterSignOutUrl={url('sign-in')} />}
</header>
{tabs.length > 0 && (
  <nav class="z-mobile-tabs" aria-label="Views">
    {mobileTabs.map(([key, label, path]) => (
      <a class="z-tab" href={`${base}${path}${noRange(key) ? '' : q}`} aria-current={tab === key ? 'page' : undefined}><Icon name={key as any} />{label}</a>
    ))}
  </nav>
)}
