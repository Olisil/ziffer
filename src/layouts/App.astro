---
import '../styles/app.css';
import { THEME_SCRIPT } from '../lib/head-scripts';
interface Props { title?: string }
const { title } = Astro.props;
const assets = (import.meta.env.ASSETS_PREFIX || import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title ? `${title} · Probe` : 'Probe'}</title>
    <link rel="icon" type="image/svg+xml" href={`${assets}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${assets}/favicon-32.png`} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${assets}/favicon-32-dark.png`} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={`${assets}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline set:html={THEME_SCRIPT} />
  </head>
  <body>
    <slot />
  </body>
</html>
