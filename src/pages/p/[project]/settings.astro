---
// Project settings: name, people, invitations, leaving and deleting. One page per project.
import App from '../../../layouts/App.astro';
import AppHeader from '../../../components/AppHeader.astro';
import SiteIcon from '../../../components/SiteIcon.astro';
import SettingsNav from '../../../components/SettingsNav.astro';
import { db, listEnvironments, listProjects, MAX_ENVIRONMENTS, ownerId, url } from '../../../lib/server';
import { fmt, isDevUser } from '../../../lib/page';
import { billable, me, membersOf, PLAN_LABEL, type Access, type Member } from '../../../lib/users';
import { actorFor, answerRequest, can, deleteProject, invite, leave, remove, setAccess, transfer } from '../../../lib/members';
import { money, seatPrice } from '../../../lib/stripe';
import { mailEnabled } from '../../../lib/mail';
import { appOrigin } from '../../../lib/notify';

const owner = ownerId(Astro);
if (!owner) return Astro.redirect(url('sign-in'));
const user = (await me(Astro))!;
const pid = String(Astro.params.project);
let projects = await listProjects(owner);
if (!projects.some((x) => x.id === pid)) return Astro.redirect(url(''));
const here = (extra = '') => Astro.redirect(url(`p/${pid}/settings${extra}`));
const ok = (m: string) => `?ok=${encodeURIComponent(m)}`;
let flash = Astro.url.searchParams.get('ok') || '';
let error = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action') || '');
  try {
    const a = await actorFor(user, pid);
    if (!a.role) throw new Error('You’re not a member of this project.');
    if (action === 'invite') { await invite(a, String(f.get('email') || ''), (f.get('access') === 'basic' ? 'basic' : 'pro') as Access, Astro.request); return here(ok('Invitation sent')); }
    if (action === 'access') { await setAccess(a, String(f.get('user')), (f.get('access') === 'basic' ? 'basic' : 'pro') as Access, Astro.request); return here(); }
    if (action === 'remove') { await remove(a, String(f.get('user')), Astro.request); return here(ok('Removed')); }
    if (action === 'leave') { await leave(a, Astro.request); return Astro.redirect(url('')); }
    if (action === 'transfer') { await transfer(a, String(f.get('user')), Astro.request); return here(ok('Project handed over')); }
    if (action === 'revoke') {
      if (!can.invite(a)) throw new Error('Only Pro members can manage invitations.');
      await db().prepare('UPDATE invitations SET revoked = 1 WHERE token = ? AND project_id = ?').bind(String(f.get('token')), pid).run();
      return here();
    }
    if (action === 'request') { await answerRequest(a, String(f.get('request')), String(f.get('answer')) as any, Astro.request); return here(); }
    if (action === 'rename') {
      if (a.access !== 'pro') throw new Error('Basic members can’t rename projects.');
      const name = String(f.get('name') || '').trim().slice(0, 80);
      if (name) await db().prepare('UPDATE projects SET name = ? WHERE id = ?').bind(name, pid).run();
      return here(ok('Saved'));
    }
    if (action === 'delete') {
      const cur = await db().prepare('SELECT name FROM projects WHERE id = ?').bind(pid).first<{ name: string }>();
      if (String(f.get('confirm') || '').trim() !== cur?.name) throw new Error(`Type the project name “${cur?.name}” to delete it.`);
      await deleteProject(a);
      return Astro.redirect(url(''));
    }
  } catch (e: any) { error = e?.message || String(e); }
}

projects = await listProjects(owner);
const p = projects.find((x) => x.id === pid)!;
const [members, envs, invites, requests, a, price] = await Promise.all([
  membersOf(pid), listEnvironments(pid),
  db().prepare('SELECT token, email, access, created, expires FROM invitations WHERE project_id = ? AND accepted_at IS NULL AND revoked = 0 AND expires > ? ORDER BY created DESC').bind(pid, Date.now()).all<{ token: string; email: string; access: Access; created: number; expires: number }>().then((r) => r.results),
  db().prepare("SELECT id, email, domain, message, created FROM access_requests WHERE project_id = ? AND status = 'open' ORDER BY created").bind(pid).all<{ id: string; email: string; domain: string; message: string | null; created: number }>().then((r) => r.results),
  actorFor(user, pid), seatPrice(),
]);
const billableSeats = members.filter(billable).length;
const initials = (s: string | null) => (s || '?').split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((x) => x[0]!.toUpperCase()).join('');
const inviteBase = `${appOrigin(Astro.request)}${url('invite/')}`;
const site = envs.find((e) => e.kind === 'web' && e.domain);
const fromEnv = envs.find((e) => e.id === Astro.url.searchParams.get('from')) ?? envs[0];
---
<App title={`${p.name} · Project settings`}>
  <AppHeader projects={projects} project={p} environments={envs} devUser={isDevUser()} />
  <main class="z-main" style="max-width:880px">
    <div class="z-title-row">
      <div class="z-title-id">
        <SiteIcon env={site} name={p.name} size={44} />
        <div>
          <div class="z-eyebrow">{p.name} · Project</div>
          <h1 class="z-h1">Settings</h1>
        </div>
      </div>
    </div>
    <SettingsNav project={p} env={fromEnv} current="project" />
    {flash && <p class="z-card" style="margin:0">{flash}</p>}
    {error && <p class="z-card" role="alert" style="margin:0;color:var(--z-coral)">{error}</p>}

    <section class="z-card" style="display:flex;flex-direction:column;gap:16px">
      <div class="z-card-head" style="margin:0"><span class="z-card-title">Project</span><span class="muted" style="margin-left:auto;font-size:12.5px">{envs.length} of {MAX_ENVIRONMENTS} environments · {members.length} {members.length === 1 ? 'person' : 'people'}{billableSeats ? ` · ${billableSeats} paid ${billableSeats === 1 ? 'seat' : 'seats'}` : ''}</span></div>
      {a.access === 'pro' ? (
        <form method="post" class="z-inline-rename"><input type="hidden" name="action" value="rename" /><input class="z-input" name="name" value={p.name} maxlength="80" aria-label="Project name" /><button class="z-btn z-btn-secondary" type="submit">Rename</button></form>
      ) : <p style="margin:0"><b>{p.name}</b></p>}
      <ul class="z-set-projects">
        {envs.map((e) => <li><SiteIcon env={e} name={e.name} size={22} /><span><b>{e.name}</b><span class="muted">{e.kind === 'web' ? (e.domain || 'Web') : 'Virtual tour'}</span></span><a class="z-link" style="margin-left:auto" href={url(`e/${e.id}/settings`)}>Site settings</a></li>)}
      </ul>
      {a.access === 'pro' && envs.length < MAX_ENVIRONMENTS && <div><a class="z-btn z-btn-secondary" href={url(`p/${p.id}/environments/new`)}>+ Add environment</a></div>}
    </section>

    <h2 class="z-set-h">People</h2>
    <p class="muted z-set-intro">The project owner handles billing, can remove anyone, hand the project over and delete it. Pro members edit everything and can invite people; they can remove Basic members. Basic members read only. Anyone can leave a project.</p>
              <section class="z-card z-set-project">


                {requests.length > 0 && can.answerRequests(a) && (
                  <div class="z-requests">
                    {requests.map((r) => (
                      <form method="post" class="z-request">
                        <input type="hidden" name="action" value="request" /><input type="hidden" name="request" value={r.id} />
                        <span><b>{r.email}</b> asks to join (tried to add {r.domain}){r.message && <> — “{r.message}”</>}</span>
                        <span class="z-request-actions">
                          <button class="z-btn z-btn-secondary" name="answer" value="pro">Invite as Pro</button>
                          <button class="z-btn z-btn-secondary" name="answer" value="basic">Invite as Basic</button>
                          <button class="z-link" name="answer" value="decline">Decline</button>
                        </span>
                      </form>
                    ))}
                  </div>
                )}

                <ul class="z-members">
                  {members.map((m: Member) => (
                    <li>
                      {m.image_url ? <img class="z-avatar" src={m.image_url} alt="" /> : <span class="z-avatar z-avatar-txt">{initials(m.name || m.email)}</span>}
                      <span class="z-member-who"><b>{m.name || m.email || 'Unknown'}{m.user_id === user.id && ' (you)'}</b><span class="muted">{m.email}</span></span>
                      <span class="z-member-tags">
                        {m.role === 'owner' && <span class="z-chip">Project owner</span>}
                        {can.changeAccess(a) && m.role !== 'owner' ? (
                          <form method="post" class="z-access-form">
                            <input type="hidden" name="action" value="access" /><input type="hidden" name="user" value={m.user_id} />
                            <select class="z-select" name="access" onchange="this.form.submit()" aria-label={`Access for ${m.email}`}>
                              <option value="pro" selected={m.access === 'pro'}>Pro (edit)</option>
                              <option value="basic" selected={m.access === 'basic'}>Basic (view)</option>
                            </select>
                          </form>
                        ) : <span class={`z-chip ${m.access}`}>{m.access === 'pro' ? 'Pro' : 'Basic'}</span>}
                        {billable(m) ? <span class="muted z-seat" title="Billed to this project">paid seat</span> : m.access === 'pro' ? <span class="muted z-seat" title={`${PLAN_LABEL[m.plan]} plan`}>free seat</span> : null}
                      </span>
                      <span class="z-member-actions">
                        {can.transfer(a) && m.role !== 'owner' && m.plan !== 'basic' && (
                          <details class="z-confirm"><summary class="z-link">Make owner</summary>
                            <form method="post"><input type="hidden" name="action" value="transfer" /><input type="hidden" name="user" value={m.user_id} />
                              <p class="muted">{m.name || m.email} becomes the project owner and handles members and billing. You stay as a Pro member.</p>
                              <button class="z-btn z-btn-secondary" type="submit">Hand over {p.name}</button></form>
                          </details>
                        )}
                        {can.remove(a, m) && (
                          <form method="post"><input type="hidden" name="action" value="remove" /><input type="hidden" name="user" value={m.user_id} /><button class="z-link danger" type="submit">Remove</button></form>
                        )}
                      </span>
                    </li>
                  ))}
                  {invites.map((i) => (
                    <li class="pending">
                      <span class="z-avatar z-avatar-txt">✉</span>
                      <span class="z-member-who"><b>{i.email}</b><span class="muted">Invited {fmt.date(i.created)} · expires {fmt.date(i.expires)}</span></span>
                      <span class="z-member-tags"><span class={`z-chip ${i.access}`}>{i.access === 'pro' ? 'Pro' : 'Basic'}</span><span class="muted z-seat">pending</span></span>
                      <span class="z-member-actions">{can.invite(a) && <button class="z-link" type="button" data-copy={`${inviteBase}${i.token}`} onclick="var b=this,sv=document.documentElement.lang==='sv',t=b.textContent;navigator.clipboard.writeText(b.dataset.copy).then(()=>{b.textContent=sv?'Kopierad':'Copied';setTimeout(()=>b.textContent=t,2000)})">Copy link</button>}{can.invite(a) && <form method="post"><input type="hidden" name="action" value="revoke" /><input type="hidden" name="token" value={i.token} /><button class="z-link" type="submit">Withdraw</button></form>}</span>
                    </li>
                  ))}
                </ul>

                {can.invite(a) && (
                  <form method="post" class="z-invite-form">
                    <input type="hidden" name="action" value="invite" />
                    <input class="z-input" type="email" name="email" required placeholder="name@company.com" aria-label="Email to invite" />
                    <select class="z-select" name="access" aria-label="Access">
                      <option value="pro">Pro — can edit{price ? ` (${money(price.amount, price.currency)}/month)` : ''}</option>
                      <option value="basic">Basic – Free — view only</option>
                    </select>
                    <button class="z-btn z-btn-primary" type="submit">Invite</button>
                  </form>
                )}
                {!mailEnabled() && can.invite(a) && <p class="muted z-small">Email isn’t connected yet, so invitations are only shown here — share the invitation link from Admin until it is.</p>}


              </section>
    <h2 class="z-set-h">Leave or delete</h2>
    <section class="z-card">
                <div class="z-set-project-foot" style="border-top:0;padding-top:0">
                  {can.leave(a) && <form method="post"><input type="hidden" name="action" value="leave" /><button class="z-btn z-btn-secondary" type="submit">Leave project</button></form>}
                  {a.role === 'owner' && !can.leave(a) && <span class="muted z-small">To leave, hand the project over to another Pro member first.</span>}
                  <span class="z-spacer"></span>
                  {can.deleteProject(a) && (
                    <details class="z-confirm"><summary class="z-link danger">Delete project</summary>
                      <form method="post"><input type="hidden" name="action" value="delete" />
                        <p class="muted">Deletes {p.name}, its {envs.length} {envs.length === 1 ? 'environment' : 'environments'} and all collected data. This can’t be undone.</p>
                        <input class="z-input" name="confirm" placeholder={`Type “${p.name}”`} autocomplete="off" />
                        <button class="z-btn z-btn-danger" type="submit">Delete forever</button></form>
                    </details>
                  )}
                </div>
    </section>
  </main>
</App>
